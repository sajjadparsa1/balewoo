# ------------------------------------------------------------------
# بالی‌وو شاپ — نمونه پیکربندی محیط
# این فایل را با نام .env کپی کنید و مقادیر را تنظیم نمایید.
# همه گزینه‌ها اختیاری‌اند؛ مقادیر پیش‌فرض برای توسعه کار می‌کنند.
# ------------------------------------------------------------------

# محیط اجرا: development | production
NODE_ENV=development

# پورت و آدرس گوش‌دادن — برای دسترسی از بیرون روی 0.0.0.0 بگذارید
PORT=3000
HOST=0.0.0.0

# آدرس عمومی سایت (برای لینک‌های پیامک/ایمیل و sitemap). مثال: https://shop.example.com
APP_URL=

# کلید رمزنگاری نشست‌ها — در محیط پروداکشن حتماً تغییر دهید
APP_KEY=please-change-this-to-a-long-random-string

# اگر پشت پروکسی معکوس (nginx/CDN) نیستید: false
TRUST_PROXY=true

# مسیر فایل پایگاه داده و آپلودها (اختیاری)
# DATA_DIR=./data
# UPLOAD_DIR=./src/public/uploads

# حداکثر حجم آپلود به مگابایت
MAX_UPLOAD_MB=12

# ------------------------------------------------------------------
# پیامک — driver: mock | kavenegar | ghasedak | melipayamak | smsir | ippanel | mediana
# mock = بدون ارسال واقعی (کد ورود در لاگ سرویس چاپ می‌شود)
# ------------------------------------------------------------------
SMS_DRIVER=mock
SMS_API_KEY=
SMS_SENDER=BALEWOO

# کد ورود ثابت برای تست (فقط محیط توسعه). خالی = کد تصادفی
OTP_FIXED=

# ------------------------------------------------------------------
# پرداخت — sandbox = همه درگاه‌ها شبیه‌سازی می‌شوند
# کلید درگاه‌ها را از پنل مدیریت ← تنظیمات ← درگاه‌های پرداخت وارد کنید
# ------------------------------------------------------------------
PAY_DRIVER=sandbox
PAY_SANDBOX=true

# ------------------------------------------------------------------
# نقشه (انتخاب فروشگاه/نقاط تحویل)
# ------------------------------------------------------------------
MAP_PROVIDER=neshan
NESHAN_API_KEY=

# ------------------------------------------------------------------
# داده نمونه — حساب‌های پیش‌فرض اسکریپت seed
# ------------------------------------------------------------------
SEED_ADMIN_PHONE=09999999999
SEED_ADMIN_PASS=12345678
SEED_SELLER_PHONE=09121111111
SEED_CUSTOMER_PHONE=09122222222
