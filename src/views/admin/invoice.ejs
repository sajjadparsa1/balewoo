<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>فاکتور <%= invoice.code %></title>
<link rel="stylesheet" href="/css/app.css">
<style>
  body { background: #eef0f5; padding: 26px; font-family: 'Vazirmatn', Tahoma, sans-serif; }
  .sheet { max-width: 820px; margin: 0 auto; background: #fff; padding: 30px 34px; border-radius: 10px; box-shadow: 0 6px 26px rgba(15,23,42,.08); color: #111; }
  .doc-actions { max-width: 820px; margin: 0 auto 16px; display: flex; gap: 10px; }
  .party { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 18px; }
  .party .box { border: 1px solid #ddd; border-radius: 8px; padding: 12px 14px; font-size: 12.5px; line-height: 2; }
  .party .box h4 { margin: 0 0 6px; font-size: 13px; }
  .barcode { display: flex; justify-content: center; margin: 6px 0 2px; }
  @media print {
    body { background: #fff; padding: 0; }
    .sheet { box-shadow: none; border-radius: 0; max-width: none; padding: 0; }
    .no-print { display: none !important; }
    @page { size: A4; margin: 14mm; }
  }
</style>
</head>
<body>

<div class="doc-actions no-print">
  <button class="btn btn-primary" type="button" onclick="window.print()">چاپ فاکتور</button>
  <a class="btn" href="/admin/orders/<%= invoice.code %>">بازگشت به سفارش</a>
</div>

<div class="sheet doc">
  <div class="doc-head">
    <div>
      <% if (invoice.shop.logo) { %><img src="<%= invoice.shop.logo %>" alt="<%= invoice.shop.name %>"><% } %>
      <h1><%= invoice.shop.name %></h1>
      <div style="font-size:12.5px;line-height:2;color:#444">
        <%= invoice.shop.address || '—' %><br>
        تلفن: <span style="direction:ltr;display:inline-block"><%= invoice.shop.phone || '—' %></span>
        <% if (invoice.shop.national_id) { %> · شناسه ملی: <span style="direction:ltr;display:inline-block"><%= invoice.shop.national_id %></span><% } %>
        <% if (invoice.shop.economic_code) { %><br>کد اقتصادی: <span style="direction:ltr;display:inline-block"><%= invoice.shop.economic_code %></span><% } %>
        <% if (invoice.shop.postal) { %> · کد پستی: <span style="direction:ltr;display:inline-block"><%= invoice.shop.postal %></span><% } %>
      </div>
    </div>
    <div style="text-align:left">
      <div style="font-size:19px;font-weight:800">فاکتور فروش</div>
      <div style="font-size:12.5px;line-height:2.1;color:#444">
        شماره سفارش: <b style="direction:ltr;display:inline-block"><%= invoice.code %></b><br>
        <% if (invoice.invoice_no) { %>شماره فاکتور: <b style="direction:ltr;display:inline-block"><%= invoice.invoice_no %></b><br><% } %>
        تاریخ: <b><%= h.formatJalaliFull(invoice.created_at) %></b><br>
        <% if (invoice.paid_at) { %>تاریخ پرداخت: <b><%= h.formatJalali(invoice.paid_at) %></b><br><% } %>
        وضعیت پرداخت: <b><%= invoice.payment_status === 'paid' ? 'پرداخت شده' : invoice.payment_status === 'refunded' ? 'بازگشت داده شده' : 'پرداخت نشده' %></b>
      </div>
    </div>
  </div>

  <div class="barcode"><%- barcode(invoice.code, { height: 42 }) %></div>

  <div class="party">
    <div class="box">
      <h4>مشخصات خریدار</h4>
      نام: <b><%= invoice.receiver_name || (invoice.user && invoice.user.name) || 'مهمان' %></b><br>
      تلفن: <b style="direction:ltr;display:inline-block"><%= invoice.receiver_phone || (invoice.user && invoice.user.phone) || '—' %></b><br>
      <% if (invoice.user && invoice.user.email) { %>ایمیل: <b style="direction:ltr;display:inline-block"><%= invoice.user.email %></b><br><% } %>
      <% if (invoice.postal_code) { %>کد پستی: <b style="direction:ltr;display:inline-block"><%= invoice.postal_code %></b><br><% } %>
      نشانی: <b><%= [invoice.address.province, invoice.address.city, invoice.address.address].filter(Boolean).join('، ') || '—' %></b>
    </div>
    <div class="box">
      <h4>مشخصات ارسال</h4>
      روش ارسال: <b><%= invoice.shipping_title || '—' %></b><br>
      کد رهگیری: <b style="direction:ltr;display:inline-block"><%= invoice.tracking_code || '—' %></b><br>
      <% if (invoice.sellers && invoice.sellers.length) { %>
        تامین‌کننده: <b><%= invoice.sellers.map(function (s) { return s.shop_name; }).join('، ') %></b><br>
      <% } %>
      <% if (invoice.customer_note) { %>یادداشت خریدار: <b><%= invoice.customer_note %></b><% } %>
    </div>
  </div>

  <table>
    <thead>
      <tr><th style="width:34px">ردیف</th><th>شرح کالا / خدمات</th><th style="width:60px">تعداد</th><th style="width:110px">فی (تومان)</th><th style="width:100px">تخفیف</th><th style="width:120px">جمع (تومان)</th></tr>
    </thead>
    <tbody>
      <% invoice.items.forEach(function (it, i) { %>
        <tr>
          <td><%= h.toPersianDigits(i + 1) %></td>
          <td>
            <%= it.title %>
            <% if (it.variant_title) { %> <span style="color:#666">— <%= it.variant_title %></span><% } %>
            <% (it.options || []).forEach(function (o) { %>
              <div style="font-size:11.5px;color:#666">+ <%= o.title %><% if (o.price) { %> (<%= h.fa(o.price) %> تومان)<% } %></div>
            <% }) %>
          </td>
          <td><%= h.toPersianDigits(it.qty) %></td>
          <td><%= h.fa(it.price) %></td>
          <td><%= it.discount ? '− ' + h.fa(it.discount) : '—' %></td>
          <td><b><%= h.fa(it.total) %></b></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="totals">
    <div><span>جمع اقلام</span><span><%= h.fa(invoice.subtotal) %></span></div>
    <% if (invoice.items_discount) { %><div><span>تخفیف محصولات</span><span>− <%= h.fa(invoice.items_discount) %></span></div><% } %>
    <% if (invoice.coupon_discount) { %><div><span>کد تخفیف (<%= invoice.coupon_code %>)</span><span>− <%= h.fa(invoice.coupon_discount) %></span></div><% } %>
    <% if (invoice.points_discount) { %><div><span>تخفیف امتیاز باشگاه</span><span>− <%= h.fa(invoice.points_discount) %></span></div><% } %>
    <% if (invoice.wallet_used) { %><div><span>پرداخت از کیف پول</span><span>− <%= h.fa(invoice.wallet_used) %></span></div><% } %>
    <div><span>هزینه ارسال</span><span><%= invoice.shipping_cost ? h.fa(invoice.shipping_cost) : 'رایگان' %></span></div>
    <% if (invoice.vat) { %><div><span>مالیات بر ارزش افزوده</span><span><%= h.fa(invoice.vat) %></span></div><% } %>
    <div class="grand"><span>مبلغ قابل پرداخت</span><span><%= h.fa(invoice.total) %> تومان</span></div>
  </div>

  <div class="words">مبلغ به حروف: <b><%= invoice.amountInWords %></b></div>

  <div class="doc-foot">
    <div style="max-width:56%;line-height:2">
      <%= setting('invoice_footer_note', 'از خرید شما سپاسگزاریم. در صورت بروز هرگونه مشکل، با پشتیبانی تماس بگیرید.') %><br>
      شرایط مرجوعی: <%= h.toPersianDigits(setting('return_days', '7')) %> روز از تاریخ تحویل.
    </div>
    <div class="doc-sign">مهر و امضای فروشنده</div>
  </div>
</div>

</body>
</html>
