<%
  const STATUS = { published: ['منتشر شده', 'badge-success'], draft: ['پیش‌نویس', 'badge-warning'] };
  const canManage = can('pages.manage');
%>
<%- include('../partials/panel-head') %>

<div class="flex items-center justify-between gap-14 flex-wrap mb-20">
  <h2 style="font-size:1.1rem;margin:0">صفحات ثابت <span class="badge badge-outline"><%= h.toPersianDigits(rows.length) %> صفحه</span></h2>
  <div class="flex gap-8">
    <a class="btn btn-sm" href="/admin/content/menus"><svg><use href="#i-menu"/></svg> منوساز</a>
    <% if (canManage) { %><a class="btn btn-sm btn-primary" href="/admin/content/pages/create"><svg><use href="#i-plus"/></svg> صفحه جدید</a><% } %>
  </div>
</div>

<section class="card">
  <% if (rows.length) { %>
    <div class="table-wrap">
      <table class="data">
        <thead><tr><th>عنوان صفحه</th><th>آدرس</th><th>بازدید</th><th>بروزرسانی</th><th>وضعیت</th><th>عملیات</th></tr></thead>
        <tbody>
          <% rows.forEach(function (r) { const st = STATUS[r.status] || [r.status, 'badge-outline']; %>
            <tr>
              <td class="text-sm bold"><%= r.title %></td>
              <td><a class="mono text-2xs" dir="ltr" href="/page/<%= r.slug %>" target="_blank" rel="noopener">/page/<%= r.slug %></a></td>
              <td class="mono text-xs"><%= h.toPersianDigits(r.views || 0) %></td>
              <td class="text-2xs"><%= r.updated_at ? h.timeAgo(r.updated_at) : h.formatJalali(r.created_at) %></td>
              <td><span class="badge <%= st[1] %>"><%= st[0] %></span></td>
              <td class="actions">
                <% if (canManage) { %>
                  <a class="btn btn-sm btn-ghost" href="/admin/content/pages/<%= r.id %>/edit" title="ویرایش"><svg><use href="#i-edit"/></svg></a>
                  <form method="post" action="/admin/content/pages/<%= r.id %>/delete" class="m-0">
                    <button class="btn btn-sm btn-ghost text-danger" type="submit" title="حذف"
                            data-confirm-click="صفحه «<%= h.truncate(r.title, 26) %>» به سطل زباله منتقل شود؟"><svg><use href="#i-trash"/></svg></button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty">
      <span class="ic"><svg><use href="#i-file"/></svg></span>
      <h3>صفحه‌ای ساخته نشده است</h3>
      <p>صفحاتی مثل «درباره ما»، «قوانین و مقررات» و «تماس با ما» را بسازید و در منوی سایت قرار دهید.</p>
      <% if (canManage) { %><a class="btn btn-sm btn-primary" href="/admin/content/pages/create"><svg><use href="#i-plus"/></svg> ساخت صفحه</a><% } %>
    </div>
  <% } %>
</section>

<%- include('../partials/panel-foot') %>
