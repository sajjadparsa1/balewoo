<%
  const canEdit = can('currency.manage');
  const dis = canEdit ? '' : 'disabled';
  const base = currencies.find(function (c) { return c.is_base; }) || currencies[0];
%>
<%- include('../../partials/panel-head') %>

<div class="flex items-center justify-between gap-14 flex-wrap mb-20">
  <h2 style="font-size:1.1rem;margin:0">نرخ ارز و تبدیل قیمت‌ها <span class="badge badge-outline"><%= h.toPersianDigits(currencies.length) %> ارز</span></h2>
  <% if (canEdit) { %><button class="btn btn-sm btn-primary" type="button" data-modal-open="curModal" onclick="openCur(null)"><svg><use href="#i-plus"/></svg> ارز جدید</button><% } %>
</div>

<div class="alert alert-warning mb-20"><svg><use href="#i-alert"/></svg><div class="body text-xs">
  «بازمحاسبه قیمت‌ها» قیمت همه محصولات و متغیرها را بر اساس ضریب جدید به‌روز می‌کند و در تاریخچه قیمت ثبت می‌شود.
  این عملیات برگشت‌پذیر نیست — پیش از اجرا از پایگاه داده پشتیبان بگیرید.
</div></div>

<div class="grid g-panel">
  <div class="stack">
    <section class="card">
      <div class="card-head"><h3 class="text-sm">ارزهای تعریف‌شده</h3></div>
      <% if (currencies.length) { %>
        <div class="table-wrap"><table class="data">
          <thead><tr><th>کد</th><th>عنوان</th><th>نرخ (به ازای واحد پایه)</th><th>بروزرسانی</th><th>وضعیت</th><% if (canEdit) { %><th>عملیات</th><% } %></tr></thead>
          <tbody><% currencies.forEach(function (c) { %>
            <tr>
              <td class="mono text-xs bold" dir="ltr"><%= c.code %></td>
              <td class="text-xs"><%= c.title || '—' %></td>
              <td class="mono text-xs"><%= h.toPersianDigits(c.rate) %></td>
              <td class="text-2xs"><%= c.updated_at ? h.timeAgo(c.updated_at) : '—' %></td>
              <td><% if (c.is_base) { %><span class="badge badge-success">ارز پایه</span><% } else { %><span class="badge badge-outline">ثانویه</span><% } %></td>
              <% if (canEdit) { %>
                <td class="actions">
                  <button class="btn btn-sm btn-ghost" type="button" title="ویرایش"
                          onclick='openCur(<%- JSON.stringify(c) %>)'><svg><use href="#i-edit"/></svg></button>
                  <% if (!c.is_base) { %>
                    <form method="post" action="/admin/settings/currency" class="m-0">
                      <input type="hidden" name="action" value="delete">
                      <input type="hidden" name="id" value="<%= c.id %>">
                      <button class="btn btn-sm btn-ghost text-danger" type="submit" title="حذف"
                              data-confirm-click="ارز <%= c.code %> حذف شود؟"><svg><use href="#i-trash"/></svg></button>
                    </form>
                  <% } %>
                </td>
              <% } %>
            </tr>
          <% }) %></tbody></table></div>
      <% } else { %>
        <div class="empty" style="padding:24px">
          <span class="ic"><svg><use href="#i-bank"/></svg></span>
          <h3>ارزی تعریف نشده است</h3>
          <p>ارز پایه (مثلا IRR با نرخ ۱) را تعریف کنید تا محاسبات مالی بر آن استوار شود.</p>
          <% if (canEdit) { %><button class="btn btn-sm btn-primary" type="button" data-modal-open="curModal" onclick="openCur(null)"><svg><use href="#i-plus"/></svg> تعریف ارز پایه</button><% } %>
        </div>
      <% } %>
    </section>

    <% if (canEdit) { %>
      <section class="card">
        <div class="card-head"><h3 class="text-sm">بازمحاسبه قیمت محصولات بر اساس نرخ جدید</h3></div>
        <div class="card-body">
          <form method="post" action="/admin/settings/currency">
            <input type="hidden" name="action" value="reprice">
            <div class="grid g-2">
              <div class="field"><label for="rp_rate">ضریب نرخ جدید</label>
                <input class="input mono" id="rp_rate" name="rate" dir="ltr" inputmode="decimal" value="1" required>
                <div class="help">عدد ۱ یعنی بدون تغییر؛ مثلا ۱.۲ یعنی ۲۰٪ افزایش قیمت.</div></div>
              <div class="field"><label>اجرا</label>
                <button class="btn btn-danger w-100" type="submit"
                        data-confirm-click="قیمت همه محصولات بر اساس ضریب واردشده بازمحاسبه شود؟ این عملیات قابل بازگشت نیست.">
                  <svg><use href="#i-refresh"/></svg> بازمحاسبه قیمت‌ها</button></div>
            </div>
            <div class="alert alert-info"><svg><use href="#i-info"/></svg><div class="body text-xs">
              قیمت‌ها به نزدیک‌ترین هزار <%= site.currency %> گرد می‌شوند و در نمودار تاریخچه قیمت محصول ثبت می‌گردند.
            </div></div>
          </form>
        </div>
      </section>
    <% } %>
  </div>

  <aside class="stack">
    <section class="card">
      <div class="card-head"><h3 class="text-sm">وضعیت فعلی</h3></div>
      <div class="card-body">
        <table class="table-kv"><tbody>
          <tr><th>واحد نمایش قیمت</th><td class="text-xs"><%= site.currency %></td></tr>
          <tr><th>ارز پایه</th><td class="mono text-xs" dir="ltr"><%= base ? base.code + ' — ' + (base.title || '') : '—' %></td></tr>
          <tr><th>تعداد ارزها</th><td class="mono"><%= h.toPersianDigits(currencies.length) %></td></tr>
        </tbody></table>
        <a class="btn btn-sm btn-outline w-100 mt-14" href="/admin/settings/general?group=identity"><svg><use href="#i-settings"/></svg> تغییر واحد پول سایت</a>
      </div>
    </section>

    <section class="card">
      <div class="card-head"><h3 class="text-sm">راهنما</h3></div>
      <div class="card-body text-xs text-muted" style="line-height:2.1">
        <ul class="bullets m-0">
          <li>اگر فروشگاه ارزی (دلار/درهم) دارید، ارز پایه را روی آن تنظیم کنید.</li>
          <li>برای فروشگاه‌های ریالی، نرخ پایه را ۱ نگه دارید.</li>
          <li>پس از تغییر نرخ، گزارش فعالیت تعداد محصولات بروزرسانی‌شده را ثبت می‌کند.</li>
        </ul>
      </div>
    </section>
  </aside>
</div>

<% if (canEdit) { %>
<div class="modal-backdrop" id="curModal">
  <div class="modal">
    <div class="modal-head"><h3 id="curTitle">ارز جدید</h3><button class="btn btn-ghost btn-sm" data-modal-close aria-label="بستن"><svg><use href="#i-x"/></svg></button></div>
    <form method="post" action="/admin/settings/currency">
      <input type="hidden" name="action" value="save">
      <input type="hidden" name="id" id="curId">
      <div class="modal-body">
        <div class="grid g-2">
          <div class="field"><label for="curCode">کد ارز <i class="req">*</i></label>
            <input class="input mono" id="curCode" name="code" dir="ltr" required placeholder="IRR / USD / AED"></div>
          <div class="field"><label for="curTitleF">عنوان</label>
            <input class="input" id="curTitleF" name="title" placeholder="ریال ایران"></div>
        </div>
        <div class="field"><label for="curRate">نرخ</label>
          <input class="input mono" id="curRate" name="rate" dir="ltr" inputmode="numeric" value="1">
          <div class="help">برای ارز پایه نرخ را ۱ بگذارید.</div></div>
        <label class="switch-row"><input type="checkbox" name="is_base" id="curBase" value="1"><span>این ارز، ارز پایه فروشگاه باشد</span></label>
      </div>
      <div class="modal-foot"><button class="btn btn-ghost" type="button" data-modal-close>انصراف</button>
        <button class="btn btn-primary" type="submit"><svg><use href="#i-save"/></svg> ذخیره</button></div>
    </form>
  </div>
</div>
<script>
  function openCur(c) {
    document.getElementById('curTitle').textContent = c ? 'ویرایش ارز' : 'ارز جدید';
    document.getElementById('curId').value = c ? c.id : '';
    document.getElementById('curCode').value = c ? c.code : '';
    document.getElementById('curTitleF').value = c ? (c.title || '') : '';
    document.getElementById('curRate').value = c ? c.rate : 1;
    document.getElementById('curBase').checked = c ? !!c.is_base : false;
  }
</script>
<% } %>

<%- include('../../partials/panel-foot') %>
