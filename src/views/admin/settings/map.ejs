<%
  const canEdit = can('settings.manage');
  const dis = canEdit ? '' : 'disabled';
  const enabled = String(setting('map_enabled', '1')) !== '0';
  const provider = setting('map_provider', 'neshan');
  const apiKey = setting('neshan_api_key', '');
  const lat = setting('map_default_lat', '35.7448');
  const lng = setting('map_default_lng', '51.3753');
  const zoom = setting('map_default_zoom', '14');
%>
<%- include('../../partials/panel-head') %>

<div class="flex items-center justify-between gap-14 flex-wrap mb-20">
  <h2 style="font-size:1.1rem;margin:0">نقشه و موقعیت‌یابی <span class="badge <%= enabled ? 'badge-success' : 'badge-warning' %>"><%= enabled ? 'فعال' : 'غیرفعال' %></span></h2>
  <% if (canEdit) { %><button class="btn btn-sm btn-primary" type="submit" form="mapForm"><svg><use href="#i-save"/></svg> ذخیره تنظیمات نقشه</button><% } %>
</div>

<form method="post" action="/admin/settings/map" id="mapForm">
  <div class="grid g-panel">
    <div class="stack">
      <section class="card">
        <div class="card-head"><h3 class="text-sm">سرویس نقشه</h3></div>
        <div class="card-body">
          <label class="switch-row mb-14"><input type="checkbox" name="map_enabled" value="1" <%= enabled ? 'checked' : '' %> <%= dis %>><span>نمایش نقشه در پابرگ، نشانی‌های کاربر و صفحه فروشگاه</span></label>
          <div class="grid g-2">
            <div class="field"><label for="mp_provider">سرویس‌دهنده</label>
              <select class="select" id="mp_provider" name="map_provider" <%= dis %>>
                <option value="neshan" <%= provider === 'neshan' ? 'selected' : '' %>>نشان (Neshan)</option>
                <option value="google" <%= provider === 'google' ? 'selected' : '' %>>گوگل مپ</option>
                <option value="leaflet" <%= provider === 'leaflet' ? 'selected' : '' %>>OpenStreetMap / Leaflet</option>
              </select>
              <div class="help">نسخه فعلی از جاسازی نشان پشتیبانی می‌کند؛ سایر موارد فقط مختصات را نمایش می‌دهند.</div></div>
            <div class="field"><label for="mp_key">کلید API نشان</label>
              <input class="input mono" id="mp_key" name="neshan_api_key" dir="ltr" value="<%= apiKey %>" placeholder="service.key.xxxx" <%= dis %>></div>
          </div>
          <div class="grid g-3">
            <div class="field"><label for="mp_lat">عرض جغرافیایی پیش‌فرض</label>
              <input class="input mono" id="mp_lat" name="map_default_lat" dir="ltr" value="<%= lat %>" <%= dis %>></div>
            <div class="field"><label for="mp_lng">طول جغرافیایی پیش‌فرض</label>
              <input class="input mono" id="mp_lng" name="map_default_lng" dir="ltr" value="<%= lng %>" <%= dis %>></div>
            <div class="field"><label for="mp_zoom">بزرگنمایی پیش‌فرض</label>
              <input class="input mono" id="mp_zoom" name="map_default_zoom" dir="ltr" inputmode="numeric" value="<%= zoom %>" <%= dis %>></div>
          </div>
          <div class="alert alert-info"><svg><use href="#i-info"/></svg><div class="body text-xs">
            این مختصات برای مرکز نقشه فروشگاه، پابرگ و فرم نشانی کاربر استفاده می‌شود. هر نشانی می‌تواند مختصات اختصاصی خود را داشته باشد.
          </div></div>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h3 class="text-sm">استان‌ها <span class="badge badge-outline"><%= h.toPersianDigits(provinces.length) %></span></h3>
          <span class="text-2xs text-muted">در فرم نشانی و فیلتر شهر فروشنده استفاده می‌شود</span></div>
        <% if (provinces.length) { %>
          <div class="table-wrap" style="max-height:420px;overflow:auto">
            <table class="data compact">
              <thead><tr><th>#</th><th>استان</th><th>نامک</th><th>مرکز استان (مختصات)</th></tr></thead>
              <tbody><% provinces.forEach(function (p, i) { %>
                <tr>
                  <td class="mono text-2xs text-muted"><%= h.toPersianDigits(i + 1) %></td>
                  <td class="text-xs bold"><%= p.name %></td>
                  <td class="mono text-2xs" dir="ltr"><%= p.slug || '—' %></td>
                  <td class="mono text-2xs" dir="ltr"><%= p.lat ? p.lat + ', ' + p.lng : '—' %></td>
                </tr>
              <% }) %></tbody></table></div>
        <% } else { %>
          <div class="empty" style="padding:22px"><p class="text-sm">استانی ثبت نشده است.</p></div>
        <% } %>
      </section>
    </div>

    <aside class="stack">
      <section class="card">
        <div class="card-head"><h3 class="text-sm">پیش‌نمایش نقشه</h3></div>
        <div class="card-body">
          <div class="map-frame" id="mapPreview" style="height:260px;border-radius:14px;overflow:hidden;border:1px solid var(--border)">
            <% if (enabled && apiKey) { %>
              <iframe src="https://www.neshan.org/maps/embed.html?zoom=<%= zoom %>&lat=<%= lat %>&lng=<%= lng %>" width="100%" height="100%" style="border:0" loading="lazy" title="پیش‌نمایش نقشه"></iframe>
            <% } else { %>
              <div class="p-14 text-xs text-muted">
                <b class="block mb-6 text-sm">نقشه فعال نیست</b>
                برای نمایش نقشه، کلید API نشان را وارد و ذخیره کنید.<br>
                مختصات فعلی: <span class="mono" dir="ltr"><%= lat %>, <%= lng %></span>
              </div>
            <% } %>
          </div>
          <div class="text-2xs text-muted mt-10">برای دیدن نتیجه در سایت، صفحه را در تب جدید باز کنید.</div>
          <a class="btn btn-sm btn-outline w-100 mt-10" href="/" target="_blank" rel="noopener"><svg><use href="#i-globe"/></svg> مشاهده سایت</a>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h3 class="text-sm">کجاها استفاده می‌شود؟</h3></div>
        <div class="card-body text-xs text-muted" style="line-height:2.1">
          <ul class="bullets m-0">
            <li>پابرگ سایت (تماس با ما)</li>
            <li>فرم ثبت نشانی در پنل کاربر</li>
            <li>صفحه فروشگاه فروشنده (موقعیت انبار)</li>
            <li>مراکز دریافت حضوری سفارش</li>
          </ul>
          <div class="divider"></div>
          <div class="stack" style="gap:8px">
            <a class="btn btn-sm btn-ghost w-100" style="justify-content:flex-start" href="/admin/shipping"><svg><use href="#i-pin"/></svg> مراکز دریافت حضوری</a>
            <a class="btn btn-sm btn-ghost w-100" style="justify-content:flex-start" href="/admin/settings/general?group=identity"><svg><use href="#i-store"/></svg> نشانی فروشگاه</a>
          </div>
        </div>
      </section>
    </aside>
  </div>
</form>

<%- include('../../partials/panel-foot') %>
