<%
  const GROUPS = [
    { key: 'products', title: 'محصولات', rows: products, cols: ['title', 'shop_name'] },
    { key: 'posts', title: 'مقالات', rows: posts, cols: ['title'] },
    { key: 'categories', title: 'دسته‌بندی‌ها', rows: categories, cols: ['name'] },
    { key: 'brands', title: 'برندها', rows: brands, cols: ['name'] },
    { key: 'pages', title: 'صفحات', rows: pages, cols: ['title'] },
    { key: 'users', title: 'کاربران', rows: users, cols: ['name', 'phone'] },
  ];
  const total = GROUPS.reduce(function (s, g) { return s + g.rows.length; }, 0);
%>
<%- include('../partials/panel-head') %>

<div class="flex items-center justify-between gap-12 flex-wrap mb-20">
  <div>
    <h2 style="font-size:1.05rem;margin:0">سطل زباله</h2>
    <div class="text-xs text-muted mt-4">موارد حذف‌شده به‌صورت نرم نگهداری می‌شوند؛ می‌توانید بازیابی یا برای همیشه حذف کنید.</div>
  </div>
  <span class="badge badge-outline"><%= h.toPersianDigits(total) %> مورد</span>
</div>

<% if (!total) { %>
  <div class="card"><div class="empty">
    <svg><use href="#i-trash"/></svg>
    <h4>سطل زباله خالی است</h4>
    <p class="text-sm">هیچ رکورد حذف‌شده‌ای وجود ندارد.</p>
    <a class="btn btn-primary btn-sm" href="/admin/dashboard">بازگشت به داشبورد</a>
  </div></div>
<% } %>

<div class="stack">
  <% GROUPS.forEach(function (g) { %>
    <% if (!g.rows.length) return; %>
    <section class="card">
      <div class="card-head"><h3 class="text-sm"><%= g.title %></h3>
        <span class="badge badge-outline"><%= h.toPersianDigits(g.rows.length) %> مورد</span></div>
      <div class="table-wrap">
        <table class="data compact">
          <thead><tr><th>شناسه</th><th>عنوان</th><% if (g.key === 'products') { %><th>فروشنده</th><% } %><% if (g.key === 'users') { %><th>موبایل</th><% } %><th>تاریخ حذف</th><th>عملیات</th></tr></thead>
          <tbody>
            <% g.rows.forEach(function (r) { %>
              <tr>
                <td class="mono text-2xs" dir="ltr">#<%= h.toPersianDigits(r.id) %></td>
                <td class="text-xs bold"><%= h.truncate(r.title || r.name || '—', 60) %></td>
                <% if (g.key === 'products') { %><td class="text-2xs"><%= r.shop_name || '—' %></td><% } %>
                <% if (g.key === 'users') { %><td class="mono text-2xs" dir="ltr"><%= h.toPersianDigits(r.phone || '') %></td><% } %>
                <td class="text-2xs"><%= h.formatJalali(r.deleted_at) %> · <%= h.timeAgo(r.deleted_at) %></td>
                <td class="actions">
                  <form method="post" action="/admin/trash/<%= g.key %>/<%= r.id %>/restore" class="m-0">
                    <button class="btn btn-sm btn-ghost" type="submit" title="بازیابی"><svg><use href="#i-refresh"/></svg></button>
                  </form>
                  <form method="post" action="/admin/trash/<%= g.key %>/<%= r.id %>/destroy" class="m-0">
                    <button class="btn btn-sm btn-ghost text-danger" type="submit" data-confirm-click="این مورد برای همیشه حذف شود؟ این عمل قابل بازگشت نیست." title="حذف دائمی"><svg><use href="#i-trash"/></svg></button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>
  <% }) %>
</div>

<div class="alert alert-warning mt-20"><svg><use href="#i-alert"/></svg>
  <div class="body">حذف دائمی رکوردها قابل بازگشت نیست. پیش از آن، از بخش <a class="text-danger bold" href="/admin/system/backup">پشتیبان‌گیری</a> یک نسخه پشتیبان بسازید.</div>
</div>

<%- include('../partials/panel-foot') %>
