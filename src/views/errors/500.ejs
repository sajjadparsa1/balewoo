<%- include('../layouts/head', { bodyClass: 'page-error' }) %>

<main id="main">
<div class="container container-xs section">
  <div class="card">
    <div class="card-body text-center" style="padding:52px 26px">
      <svg width="62" height="62" style="color:var(--danger);width:62px;height:62px"><use href="#i-alert"/></svg>
      <h1 style="font-size:1.2rem;margin:14px 0 8px">خطای داخلی سرور</h1>
      <p class="text-sm text-muted mb-20">متاسفانه پردازش درخواست شما با مشکل مواجه شد. تیم فنی به‌صورت خودکار از این خطا مطلع شد؛ کمی دیگر دوباره تلاش کنید.</p>

      <% if (error) { %>
        <details class="text-left mb-20" style="text-align:left">
          <summary class="text-sm text-danger" style="cursor:pointer">نمایش جزئیات خطا (حالت توسعه)</summary>
          <pre class="article-body" style="background:var(--surface-2);padding:14px;border-radius:10px;overflow:auto;font-size:.75rem;max-height:280px;margin-top:10px"><code><%= error.message %>

<%= (error.stack || '').split('\n').slice(0, 12).join('\n') %></code></pre>
        </details>
      <% } %>

      <div class="flex gap-10 justify-center flex-wrap">
        <button class="btn btn-primary" type="button" onclick="location.reload()"><svg><use href="#i-refresh"/></svg> تلاش مجدد</button>
        <a class="btn btn-outline" href="/">صفحه نخست</a>
        <a class="btn btn-ghost" href="/form/contact-us">گزارش مشکل</a>
      </div>
    </div>
  </div>
</div>
</main>
<script src="/js/app.js" defer></script>
</body>
</html>
