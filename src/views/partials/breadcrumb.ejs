<% const crumbs = items || []; %>
<% if (crumbs.length) { %>
<nav class="breadcrumb" aria-label="مسیر">
  <a href="/">خانه</a>
  <% crumbs.forEach((c, i) => { %>
    <span class="sep">/</span>
    <% if (c.url && i < crumbs.length - 1) { %><a href="<%= c.url %>"><%= c.name %></a>
    <% } else { %><span class="text-muted"><%= c.name %></span><% } %>
  <% }) %>
</nav>
<% } %>
