<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>برچسب ارسال <%= label.order_code %></title>
<link rel="stylesheet" href="/css/app.css">
<style>
  body { background: #f1f2f6; padding: 24px; font-family: var(--font-body, 'Vazirmatn', Tahoma, sans-serif); }
  .label-sheet { display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .label-doc { width: 400px; }
  .label-doc .big-code { font-family: monospace; font-size: 26px; font-weight: 800; letter-spacing: 2px; direction: ltr; text-align: center; }
  .label-doc .kv { display: flex; justify-content: space-between; gap: 8px; font-size: 11.5px; padding: 3px 0; }
  .label-doc .kv b { font-weight: 700; }
  .label-doc .sep { border-top: 1px dashed #666; margin: 8px 0; }
  .label-doc .barcode { display: flex; justify-content: center; margin-top: 6px; }
  .label-doc .barcode svg { max-width: 100%; height: auto; }
  .label-actions { display: flex; gap: 10px; }
  @media print {
    body { background: #fff; padding: 0; }
    .no-print { display: none !important; }
    .label-doc { border-width: 1.5px; width: auto; max-width: 400px; }
    @page { margin: 8mm; }
  }
</style>
</head>
<body>
<div class="label-sheet">

  <div class="label-actions no-print">
    <button class="btn btn-primary" type="button" onclick="window.print()">چاپ برچسب</button>
    <a class="btn" href="/seller/orders">بازگشت به سفارش‌ها</a>
  </div>

  <div class="label-doc">
    <div class="row2">
      <div>
        <h3><%= label.shop.name %></h3>
        <div class="addr">
          <%= label.shop.address || '—' %><br>
          تلفن: <span style="direction:ltr;display:inline-block"><%= label.shop.phone || '—' %></span>
          <% if (label.shop.postal) { %> · کد پستی: <span style="direction:ltr;display:inline-block"><%= label.shop.postal %></span><% } %>
        </div>
      </div>
      <% if (label.shop.logo) { %><img src="<%= label.shop.logo %>" alt="" style="height:44px"><% } %>
    </div>

    <div class="big-code"><%= label.order_code %></div>
    <div class="barcode"><%- barcode(label.order_code, { height: 44 }) %></div>

    <div class="sep"></div>

    <div class="addr">
      <b>گیرنده:</b> <%= label.receiver.name || '—' %><br>
      <b>تلفن:</b> <span style="direction:ltr;display:inline-block"><%= label.receiver.phone || '—' %></span><br>
      <b>نشانی:</b> <%= [label.receiver.province, label.receiver.city, label.receiver.address].filter(Boolean).join('، ') || '—' %><br>
      <% if (label.receiver.postal_code) { %><b>کد پستی:</b> <span style="direction:ltr;display:inline-block"><%= label.receiver.postal_code %></span><% } %>
    </div>

    <div class="sep"></div>

    <div class="kv"><span>روش ارسال</span><b><%= label.shipping_title || '—' %></b></div>
    <div class="kv"><span>کد رهگیری</span><b style="direction:ltr"><%= label.tracking_code || '—' %></b></div>
    <div class="kv"><span>تعداد اقلام</span><b><%= h.toPersianDigits(label.items_count) %></b></div>
    <div class="kv"><span>وزن مرسوله</span><b><%= label.weight ? h.toPersianDigits(Math.round(label.weight)) + ' گرم' : '—' %></b></div>
    <div class="kv"><span>تاریخ صدور</span><b><%= h.formatJalali(label.created_at) %></b></div>

    <div class="sep"></div>
    <div class="addr" style="text-align:center">از باز کردن بسته در حضور مامور پست خودداری نکنید؛ در صورت آسیب، صورت‌جلسه تنظیم شود.</div>
  </div>

  <% if (order && order.items && order.items.length) { %>
    <div class="label-doc" style="width:400px">
      <div class="row2"><h3>فهرست اقلام سفارش <%= order.code %></h3></div>
      <table style="width:100%;border-collapse:collapse;font-size:11.5px">
        <thead><tr style="border-bottom:1.5px solid #111">
          <th style="text-align:right;padding:5px 2px">محصول</th>
          <th style="text-align:center;padding:5px 2px">تعداد</th>
        </tr></thead>
        <tbody>
          <% order.items.forEach(function (it) { %>
            <tr style="border-bottom:1px dotted #999">
              <td style="padding:5px 2px;text-align:right"><%= it.title %><% if (it.variant_title) { %> (<%= it.variant_title %>)<% } %></td>
              <td style="padding:5px 2px;text-align:center"><%= h.toPersianDigits(it.qty) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>

</div>
</body>
</html>
