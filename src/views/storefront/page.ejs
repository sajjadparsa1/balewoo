<%- include('../layouts/head', { bodyClass: 'page-static' }) %>
<%- include('../partials/store-header') %>

<main id="main" data-spa-content>
<div class="container container-sm">
  <%- include('../partials/breadcrumb', { items: [{ name: page.title }] }) %>

  <article class="card">
    <div class="card-body" style="padding:26px 28px">
      <h1 style="font-size:1.35rem;margin-bottom:6px"><%= page.title %></h1>
      <div class="flex items-center gap-14 text-xs text-muted mb-20">
        <span class="flex items-center gap-4"><svg width="13" height="13" style="width:13px;height:13px"><use href="#i-clock"/></svg> آخرین بروزرسانی: <%= h.formatJalali(page.updated_at || page.created_at) %></span>
        <span class="flex items-center gap-4"><svg width="13" height="13" style="width:13px;height:13px"><use href="#i-eye"/></svg> <%= h.toPersianDigits(page.views || 0) %> بازدید</span>
      </div>
      <div class="article-body"><%- page.body %></div>
    </div>
  </article>

  <% if (page.slug === 'terms' || page.slug === 'privacy' || page.slug === 'how-to-buy') { %>
    <div class="card mt-20"><div class="card-body flex items-center justify-between gap-14 flex-wrap">
      <div>
        <div class="bold">پاسخ پرسش خود را پیدا نکردید؟</div>
        <div class="text-sm text-muted">تیم پشتیبانی ما در تمام ساعات شبانه‌روز آماده پاسخگویی است.</div>
      </div>
      <div class="flex gap-8">
        <a class="btn btn-outline" href="/faq">پرسش‌های متداول</a>
        <a class="btn btn-primary" href="/form/contact-us">تماس با ما</a>
      </div>
    </div></div>
  <% } %>
</div>
</main>

<%- include('../partials/store-footer') %>
