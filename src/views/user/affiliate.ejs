<%
  const refLink = (siteUrl || '') + '/?ref=' + (user.affiliate_code || '');
  const levelTitles = { gold: 'طلایی', silver: 'نقره‌ای', bronze: 'برنزی' };
  const statusTitle = { pending: 'در انتظار تایید', approved: 'تایید شده', paid: 'پرداخت شده', rejected: 'رد شده' };
%>
<%- include('../partials/panel-head') %>

<% if (!user.is_affiliate) { %>
  <div class="card mb-20">
    <div class="card-body text-center" style="padding:36px 24px">
      <svg width="44" height="44" style="color:var(--brand);width:44px;height:44px"><use href="#i-gift"/></svg>
      <h2 style="font-size:1.1rem;margin:14px 0 8px">کسب درآمد از همکاری در فروش</h2>
      <p class="text-sm text-muted mb-20" style="max-width:560px;margin:0 auto 20px">
        لینک اختصاصی محصولات را در شبکه‌های اجتماعی یا وب‌سایت خود منتشر کنید. هر خریدی که از طریق لینک شما انجام شود،
        پورسانت سه‌سطحی (طلایی، نقره‌ای، برنزی) به کیف پول شما اضافه می‌شود.
      </p>
      <form method="post" action="/user/affiliate/activate">
        <button class="btn btn-primary btn-lg" type="submit"><svg><use href="#i-zap"/></svg> فعال‌سازی همکاری در فروش</button>
      </form>
      <div class="text-xs text-muted mt-14">پورسانت پیش‌فرض: طلایی <%= h.toPersianDigits(setting('affiliate_gold_percent', '5')) %>٪ · نقره‌ای <%= h.toPersianDigits(setting('affiliate_silver_percent', '3')) %>٪ · برنزی <%= h.toPersianDigits(setting('affiliate_bronze_percent', '1')) %>٪</div>
    </div>
  </div>
<% } else { %>
  <div class="stat-cards mb-20">
    <div class="stat-card success"><span class="ic"><svg><use href="#i-wallet"/></svg></span>
      <div><div class="v mono"><%= h.fa(stats.total) %></div><div class="l">کل پورسانت (<%= site.currency %>)</div></div></div>
    <div class="stat-card"><span class="ic"><svg><use href="#i-check"/></svg></span>
      <div><div class="v mono"><%= h.fa(stats.approved) %></div><div class="l">تایید و پرداخت‌شده</div></div></div>
    <div class="stat-card warning"><span class="ic"><svg><use href="#i-clock"/></svg></span>
      <div><div class="v mono"><%= h.fa(stats.pending) %></div><div class="l">در انتظار تایید</div></div></div>
    <div class="stat-card info"><span class="ic"><svg><use href="#i-target"/></svg></span>
      <div><div class="v mono"><%= h.toPersianDigits(stats.clicks) %></div><div class="l">کلیک روی لینک‌ها</div></div></div>
    <div class="stat-card"><span class="ic"><svg><use href="#i-users"/></svg></span>
      <div><div class="v mono"><%= h.toPersianDigits(stats.referrals) %></div><div class="l">زیرمجموعه‌ها</div></div></div>
    <div class="stat-card danger"><span class="ic"><svg><use href="#i-cart"/></svg></span>
      <div><div class="v mono"><%= h.toPersianDigits(stats.sales) %></div><div class="l">فروش موفق</div></div></div>
  </div>

  <section class="card mb-20">
    <div class="card-head"><h3>لینک اختصاصی شما</h3><span class="badge badge-primary mono" dir="ltr"><%= user.affiliate_code %></span></div>
    <div class="card-body">
      <div class="field">
        <label for="refLink">لینک معرفی (با کلیک روی آن، خرید به نام شما ثبت می‌شود)</label>
        <div class="input-group">
          <input class="input mono" id="refLink" readonly value="<%= refLink %>" dir="ltr" onclick="this.select()">
          <button class="btn btn-primary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('refLink').value).then(function(){toast('لینک کپی شد','success')})"><svg><use href="#i-copy"/></svg> کپی</button>
        </div>
        <div class="help">می‌توانید این لینک را به انتهای آدرس هر محصول اضافه کنید: <span class="mono" dir="ltr">?ref=<%= user.affiliate_code %></span></div>
      </div>
      <div class="flex gap-8 flex-wrap">
        <a class="btn btn-sm btn-outline" target="_blank" rel="noopener"
           href="https://t.me/share/url?url=<%= encodeURIComponent(refLink) %>&text=<%= encodeURIComponent('این فروشگاه را از دست نده!') %>"><svg><use href="#i-telegram"/></svg> اشتراک در تلگرام</a>
        <a class="btn btn-sm btn-outline" target="_blank" rel="noopener"
           href="https://wa.me/?text=<%= encodeURIComponent(refLink) %>"><svg><use href="#i-whatsapp"/></svg> اشتراک در واتس‌اپ</a>
        <a class="btn btn-sm btn-outline" target="_blank" rel="noopener"
           href="https://x.com/intent/tweet?url=<%= encodeURIComponent(refLink) %>"><svg><use href="#i-x-social"/></svg> اشتراک در ایکس</a>
      </div>
    </div>
  </section>

  <div class="grid g-panel">
    <section class="card">
      <div class="card-head"><h3 class="text-sm">گزارش پورسانت‌ها</h3></div>
      <% if (commissions.length) { %>
        <div class="table-wrap">
          <table class="data compact">
            <thead><tr><th>تاریخ</th><th>محصول</th><th>سفارش</th><th>سطح</th><th>درصد</th><th>مبلغ</th><th>وضعیت</th></tr></thead>
            <tbody>
              <% commissions.forEach(function (c) { %>
                <tr>
                  <td class="text-xs"><%= h.formatJalali(c.created_at) %></td>
                  <td class="text-xs"><% if (c.slug) { %><a class="text-brand" href="/product/<%= c.slug %>"><%= h.truncate(c.title || '—', 38) %></a><% } else { %><%= h.truncate(c.title || '—', 38) %><% } %></td>
                  <td class="text-xs mono" dir="ltr"><%= c.order_code || '—' %></td>
                  <td class="text-xs"><%= levelTitles[c.level] || c.level %></td>
                  <td class="mono text-xs"><%= h.toPersianDigits(c.percent) %>٪</td>
                  <td class="mono bold"><%= h.fa(c.amount) %></td>
                  <td><span class="badge <%= c.status === 'paid' ? 'badge-success' : c.status === 'approved' ? 'badge-info' : c.status === 'pending' ? 'badge-warning' : 'badge-danger' %>"><%= statusTitle[c.status] || c.status %></span></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty"><svg><use href="#i-link"/></svg><h4>پورسانتی ثبت نشده است</h4>
          <p class="text-sm">لینک اختصاصی خود را منتشر کنید تا خریدها به نام شما ثبت شود.</p></div>
      <% } %>
    </section>

    <aside class="stack">
      <section class="card">
        <div class="card-head"><h3 class="text-sm">محصولات دارای پورسانت</h3></div>
        <div class="card-body stack" style="gap:10px;max-height:420px;overflow:auto">
          <% (products || []).forEach(function (pp) { %>
            <div class="flex items-center gap-10">
              <span class="grow"><a class="text-xs line-2" href="/product/<%= pp.slug %>?ref=<%= user.affiliate_code %>" target="_blank"><%= h.truncate(pp.title, 46) %></a>
                <span class="text-xs text-muted" style="display:block">پورسانت: <%= h.toPersianDigits(pp.aff_gold) %>٪ / <%= h.toPersianDigits(pp.aff_silver) %>٪ / <%= h.toPersianDigits(pp.aff_bronze) %>٪</span></span>
              <button class="btn btn-sm btn-ghost" type="button" title="کپی لینک"
                      onclick="navigator.clipboard.writeText('<%= (siteUrl || '') %>/product/<%= pp.slug %>?ref=<%= user.affiliate_code %>').then(function(){toast('لینک محصول کپی شد','success')})"><svg width="15" height="15" style="width:15px;height:15px"><use href="#i-copy"/></svg></button>
            </div>
          <% }) %>
          <% if (!(products || []).length) { %><p class="text-xs text-muted m-0">فعلاً محصولی برای همکاری در فروش فعال نشده است.</p><% } %>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h3 class="text-sm">نحوه محاسبه</h3></div>
        <div class="card-body text-xs text-muted" style="line-height:2.2">
          پورسانت پس از تحویل سفارش و گذشت مهلت مرجوعی تایید می‌شود و به کیف پول شما اضافه می‌گردد.
          در سفارش‌های لغو یا مرجوع‌شده، پورسانت کسر می‌شود.
          <a class="btn btn-sm btn-outline w-100 mt-10" href="/user/wallet">مشاهده کیف پول</a>
        </div>
      </section>
    </aside>
  </div>
<% } %>

<%- include('../partials/panel-foot') %>
