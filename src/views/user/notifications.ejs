<%
  const typeIcon = { order: 'cart', payment: 'wallet', ticket: 'message', club: 'award', affiliate: 'gift', system: 'info', info: 'info', warning: 'alert', danger: 'ban', success: 'check' };
%>
<%- include('../partials/panel-head') %>

<div class="flex items-center justify-between gap-12 mb-20 flex-wrap">
  <div class="text-sm text-muted">همه اعلان‌های حساب شما: سفارش، پرداخت، تیکت، باشگاه مشتریان و همکاری در فروش.</div>
  <div class="flex gap-8">
    <% const unread = rows.filter(function (n) { return !n.read_at; }).length; %>
    <% if (unread) { %>
      <form method="post" action="/user/notifications/read-all" class="m-0">
        <button class="btn btn-sm btn-primary" type="submit"><svg><use href="#i-check"/></svg> خواندن همه</button>
      </form>
    <% } %>
    <a class="btn btn-sm" href="/user/profile">تنظیمات حساب</a>
  </div>
</div>

<section class="card">
  <% if (rows.length) { %>
    <div class="notif-list">
      <% rows.forEach(function (n) { %>
        <div class="notif-item <%= n.read_at ? '' : 'unread' %>">
          <span class="notif-ic"><svg><use href="#i-<%= typeIcon[n.icon] || typeIcon[n.type] || 'bell' %>"/></svg></span>
          <div class="grow">
            <div class="flex items-center gap-8 flex-wrap">
              <b class="text-sm"><%= n.title %></b>
              <% if (!n.read_at) { %><span class="badge badge-primary">جدید</span><% } %>
            </div>
            <% if (n.body) { %><p class="text-xs text-muted m-0 mt-4" style="line-height:1.9"><%= n.body %></p><% } %>
            <div class="text-2xs text-muted mt-6"><%= h.formatJalaliFull(n.created_at) %> · <%= h.timeAgo(n.created_at) %><% if (n.sms_sent) { %> · پیامک ارسال شد<% } %></div>
          </div>
          <div class="flex gap-6" style="flex:none">
            <% if (n.link) { %><a class="btn btn-sm btn-ghost" href="<%= n.link %>" title="مشاهده"><svg><use href="#i-chevron-left"/></svg></a><% } %>
            <% if (!n.read_at) { %>
              <form method="post" action="/user/notifications/<%= n.id %>/read" class="m-0">
                <button class="btn btn-sm btn-ghost" type="submit" title="خوانده‌شده"><svg><use href="#i-check"/></svg></button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
    <div class="card-foot"><%- include('../partials/pagination', { pagination: pg, baseUrl: '/user/notifications', extraQuery: {} }) %></div>
  <% } else { %>
    <div class="empty"><svg><use href="#i-bell"/></svg>
      <h4>اعلانی ندارید</h4>
      <p class="text-sm">رویدادهای حساب شما اینجا و در صورت فعال بودن، از طریق پیامک اطلاع‌رسانی می‌شود.</p>
      <a class="btn btn-primary btn-sm" href="/user/dashboard">بازگشت به پیشخوان</a></div>
  <% } %>
</section>

<%- include('../partials/panel-foot') %>
