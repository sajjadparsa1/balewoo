<%
  const statusTitle = { pending: 'در انتظار پرداخت', paid: 'پرداخت شده', canceled: 'لغو شده', expired: 'منقضی شده' };
%>
<%- include('../partials/panel-head') %>

<div class="flex items-center justify-between gap-12 flex-wrap mb-20">
  <div>
    <h2 style="font-size:1.05rem;margin:0" class="flex items-center gap-10">پیش‌فاکتور <span class="mono" dir="ltr"><%= pi.code %></span>
      <span class="badge <%= pi.status === 'paid' ? 'badge-success' : pi.status === 'pending' ? 'badge-warning' : 'badge-danger' %>"><%= statusTitle[pi.status] || pi.status %></span></h2>
    <div class="text-xs text-muted mt-6">تاریخ صدور: <%= h.formatJalaliFull(pi.created_at) %><% if (pi.expires_at) { %> · اعتبار تا <%= h.formatJalali(pi.expires_at) %><% } %></div>
  </div>
  <div class="flex gap-8">
    <a class="btn btn-sm" href="/user/preinvoices"><svg><use href="#i-chevron-right"/></svg> بازگشت</a>
    <button class="btn btn-sm" type="button" onclick="window.print()"><svg><use href="#i-print"/></svg> چاپ</button>
  </div>
</div>

<div class="grid g-panel">
  <section class="card">
    <div class="card-head"><h3 class="text-sm">اقلام پیش‌فاکتور</h3></div>
    <div class="table-wrap">
      <table class="data">
        <thead><tr><th>#</th><th>شرح</th><th>تعداد</th><th>فی</th><th>تخفیف</th><th>مبلغ</th></tr></thead>
        <tbody>
          <% (pi.items || []).forEach(function (it, i) { %>
            <tr>
              <td class="mono"><%= h.toPersianDigits(i + 1) %></td>
              <td><%= it.title %><% if (it.variant_title) { %> <span class="text-xs text-muted">(<%= it.variant_title %>)</span><% } %></td>
              <td class="mono"><%= h.toPersianDigits(it.qty || 1) %></td>
              <td class="mono"><%= h.fa(it.price) %></td>
              <td class="mono text-success"><%= it.discount ? '− ' + h.fa(it.discount) : '—' %></td>
              <td class="mono bold"><%= h.fa((it.qty || 1) * it.price - (it.discount || 0)) %></td>
            </tr>
          <% }) %>
          <% if (!(pi.items || []).length) { %>
            <tr><td colspan="6" class="text-center text-muted" style="padding:30px">قلمی ثبت نشده است</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
    <div class="card-foot">
      <div class="summary-row"><span>جمع کل</span><span class="mono"><%= h.fa(pi.subtotal) %></span></div>
      <% if (pi.discount) { %><div class="summary-row"><span>تخفیف</span><span class="discount mono">− <%= h.fa(pi.discount) %></span></div><% } %>
      <% if (pi.vat) { %><div class="summary-row"><span>مالیات بر ارزش افزوده</span><span class="mono"><%= h.fa(pi.vat) %></span></div><% } %>
      <div class="summary-row total"><span>مبلغ قابل پرداخت</span><span class="mono"><%= h.fa(pi.total) %> <%= site.currency %></span></div>
      <% if (pi.note) { %><div class="text-xs text-muted mt-10"><b>توضیحات:</b> <%= pi.note %></div><% } %>
    </div>
  </section>

  <aside class="stack">
    <% if (pi.status === 'pending') { %>
      <section class="card">
        <div class="card-head"><h3 class="text-sm">پرداخت</h3></div>
        <div class="card-body">
          <form method="post" action="/payment/preinvoice/pay/<%= pi.code %>">
            <div class="stack" data-choice-group="pm">
              <% if ((user.wallet || 0) >= pi.total) { %>
                <label class="pay-method active"><input type="radio" name="method" value="wallet" checked>
                  <span class="grow"><span class="t">کیف پول</span><span class="d" style="display:block">موجودی <%= h.fa(user.wallet) %> <%= site.currency %></span></span></label>
              <% } %>
              <label class="pay-method">
                <input type="radio" name="method" value="gateway" <%= (user.wallet || 0) >= pi.total ? '' : 'checked' %>>
                <span class="grow"><span class="t">درگاه اینترنتی</span>
                  <select class="select mt-6" name="gateway" style="width:100%">
                    <% (gateways || []).filter(function (g) { return g.type === 'online' || g.type === 'installment'; }).forEach(function (g) { %>
                      <option value="<%= g.key %>"><%= g.name %></option>
                    <% }) %>
                  </select></span>
              </label>
            </div>
            <button class="btn btn-primary btn-block mt-14" type="submit"><svg><use href="#i-lock"/></svg> پرداخت <%= h.fa(pi.total) %> <%= site.currency %></button>
          </form>
        </div>
      </section>
    <% } else if (pi.status === 'paid') { %>
      <div class="alert alert-success"><svg><use href="#i-check"/></svg><div class="body">این پیش‌فاکتور در تاریخ <%= h.formatJalali(pi.paid_at) %> پرداخت شده است.</div></div>
    <% } else { %>
      <div class="alert alert-danger"><svg><use href="#i-ban"/></svg><div class="body">این پیش‌فاکتور <%= statusTitle[pi.status] %> است و امکان پرداخت ندارد.</div></div>
    <% } %>

    <section class="card">
      <div class="card-head"><h3 class="text-sm">راهنما</h3></div>
      <div class="card-body text-xs text-muted" style="line-height:2.2">
        پیش‌فاکتور سندی غیرقطعی است که برای تایید مبلغ و اقلام پیش از صدور فاکتور نهایی صادر می‌شود.
        پس از پرداخت، فاکتور رسمی در بخش سفارش‌ها قابل دریافت است.
        <div class="mt-10"><a class="btn btn-sm btn-outline w-100" href="/user/tickets/new"><svg><use href="#i-ticket"/></svg> سوال درباره این پیش‌فاکتور</a></div>
      </div>
    </section>
  </aside>
</div>

<%- include('../partials/panel-foot') %>
